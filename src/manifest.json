{
  "manifest_version": 3,
  "name": "InfiniTabs",
  "version": "0.4.9",
  "description": "Unlimited tabs. Zero clutter. Near-zero RAM.",
  "homepage_url": "https://github.com/lrq3000/infinitabs,",
  "permissions": [
    "tabs",
    "bookmarks",
    "windows",
    "storage",
    "sidePanel",
    "favicon",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Open InfiniTabs Sidebar"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "unmount-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "Command+Shift+U"
      },
      "description": "Unmount the current tab",
      "global": true
    }
  }
}